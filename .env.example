# ─── Robinhood Chain Testnet ────────────────────────────────────────────────
# Public RPC is rate-limited. Use provider infrastructure (e.g. Alchemy) in production.
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_TESTNET_WSS_URL=
BLOCKSCOUT_API_URL=https://explorer.testnet.chain.robinhood.com/api

# ─── Storage ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres@localhost:5432/vibeproof
# On Vercel, the Neon/Postgres integration's POSTGRES_URL is also accepted.
# Pooled (-pooler) URLs automatically disable prepared statements.
# Optional in development. Production requires shared Redis request limiting.
REDIS_URL=redis://localhost:6379
# On Vercel, the Upstash/KV integration's KV_URL (rediss://…) is also accepted.

# ─── Integrations ───────────────────────────────────────────────────────────
# Optional. Raises GitHub API limits from 60/h to 5000/h. Read-only, no scopes needed.
GITHUB_TOKEN=

# ─── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 32+ random bytes, used to sign session cookies. `openssl rand -hex 32`
SESSION_SECRET=
# true = deterministic, clearly-labelled demo dataset. Never mixed with testnet data.
NEXT_PUBLIC_DEMO_MODE=false
# Optional. Free project ID from https://cloud.reown.com — adds a WalletConnect option (any mobile wallet via QR).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# VibeProofRegistry on Robinhood Chain Testnet (deployed + source-verified 2026-09-30; see deployments/). Blank disables anchoring.
NEXT_PUBLIC_REGISTRY_ADDRESS=0x47b639e587FdBf9A8323d030C9930744BfbF2F2E

# ─── Indexer ────────────────────────────────────────────────────────────────
INDEXER_BATCH_BLOCKS=2000
INDEXER_POLL_MS=4000
# Optional override of the first block to index (defaults to factory deploy blocks)
INDEXER_START_BLOCK=

# ─── Scheduled indexer (serverless) ─────────────────────────────────────────
# Bearer secret for GET /api/cron/indexer (Vercel Cron / GitHub Actions). 16+ chars. `openssl rand -hex 32`
CRON_SECRET=
# Seconds the function may run (120–300). Reserve 90s for bounded maintenance.
INDEXER_JOB_BUDGET_S=300

# ─── Production integrity and developer platform ───────────────────────────
# Shared Redis is REQUIRED for production API request limiting.
# Only enable behind an ingress that overwrites incoming forwarding headers.
TRUST_PROXY=false
NEXT_PUBLIC_VIBEPROOF_NETWORK=robinhood-testnet
INDEXER_NETWORKS=robinhood-testnet
ROBINHOOD_MAINNET_REGISTRY_ADDRESS=
# database: content-addressed canonical bytes retained on this app's origin.
# ipfs: explicitly configured Kubo raw-block API; never uploads without configuration.
EVIDENCE_STORAGE=database
IPFS_WRITE_API=
IPFS_WRITE_TOKEN=
# Comma-separated HTTPS gateway templates, {cid} and {path} placeholders.
IPFS_GATEWAYS=
PROOF_CONFIRMATIONS=12
# 32 bytes hex; encrypts webhook signing secrets at rest. openssl rand -hex 32
WEBHOOK_ENCRYPTION_KEY=CHANGE_ME
HEALTH_MAX_TICK_AGE_S=900
HEALTH_MAX_LAG_BLOCKS=2000
ALERT_SUSTAIN_S=300
ALERT_COOLDOWN_S=3600
ALERT_MAX_DEAD_LETTERS=0
ALERT_MAX_PENDING_BACKFILLS=10000
ALERT_MAX_METADATA_FAILURES=100
ALERT_MAX_RPC_ERROR_RATE=0.25
# GitHub Actions repository VARIABLE (not application runtime): exact allowed hosts.
# VIBEPROOF_ALLOWED_HOSTS=your-app.vercel.app

# Durable operational alert delivery. Empty URL delivers structured logs through the queue.
# An explicit public HTTPS receiver; no URL credentials, query string or redirects.
ALERT_WEBHOOK_URL=
# 32+ random characters; HMAC signing only, never included in the payload.
ALERT_WEBHOOK_SECRET=
# Queue growth over a persisted baseline at least 5 minutes old, at most 30 minutes old.
ALERT_TREND_WINDOW_S=300
ALERT_TREND_MAX_AGE_S=1800
ALERT_DEAD_LETTER_GROWTH=1
ALERT_BACKFILL_GROWTH=100
ALERT_MAX_RPC_THROTTLE_RATE=0.1
