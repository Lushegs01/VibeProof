{
  "name": "vibeproof",
  "version": "0.1.0",
  "private": true,
  "description": "The verification layer for Vibe launches on Robinhood Chain.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e:build": "NEXT_PUBLIC_APP_URL=http://localhost:3100 NEXT_PUBLIC_DEMO_MODE=true NEXT_DIST_DIR=.next-e2e next build",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "indexer": "tsx src/indexer/run.ts",
    "indexer:once": "tsx src/indexer/run.ts --once",
    "indexer:recount": "tsx src/indexer/run.ts --recount",
    "indexer:bootstrap": "tsx src/indexer/run.ts --bootstrap",
    "vibe:verify": "tsx src/indexer/verify-deployments.ts",
    "forge:build": "forge build",
    "forge:test": "forge test -vv",
    "deploy:testnet": "forge script script/DeployVibeProofRegistry.s.sol:DeployVibeProofRegistry --rpc-url robinhood_testnet --broadcast --account ${DEPLOYER_ACCOUNT:-vibeproof-deployer}",
    "verify:testnet": "forge verify-contract --chain-id 46630 --verifier blockscout --verifier-url https://explorer.testnet.chain.robinhood.com/api/ ${REGISTRY_ADDRESS} contracts/VibeProofRegistry.sol:VibeProofRegistry",
    "vercel-build": "tsx src/lib/db/migrate.ts --if-configured && next build",
    "lint": "tsc --noEmit && node scripts/validate-migrations.mjs",
    "format:check": "node scripts/format.mjs",
    "format:write": "node scripts/format.mjs --write",
    "test:local": "SKIP_NETWORK_TESTS=1 vitest run",
    "test:live": "vitest run tests/integration/rpc.test.ts",
    "env:validate": "node scripts/validate-environment.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:wallet": "playwright test -c playwright.wallet.config.ts",
    "test:wallet:prepare": "forge build"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource-variable/unbounded": "5.3.0",
    "@metamask/connect-evm": "2.1.1",
    "@tanstack/react-query": "5.104.0",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "framer-motion": "13.4.6",
    "geist": "1.7.2",
    "ioredis": "6.0.0",
    "lucide-react": "1.49.0",
    "next": "16.4.5",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "viem": "2.57.1",
    "wagmi": "3.7.11",
    "zod": "4.6.7",
    "@walletconnect/universal-provider": "2.26.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@foundry-rs/anvil": "1.7.1",
    "@foundry-rs/forge": "1.7.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.11",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.1.0",
    "@types/qrcode": "1.5.6"
  },
  "overrides": {
    "@metamask/utils": {
      "uuid": "11.1.1"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
