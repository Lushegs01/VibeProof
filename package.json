{
  "name": "vibeproof",
  "version": "0.1.0",
  "private": true,
  "description": "The verification layer for Vibe launches on Robinhood Chain.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e:build": "NEXT_PUBLIC_DEMO_MODE=true NEXT_DIST_DIR=.next-e2e next build",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "indexer": "tsx src/indexer/run.ts",
    "indexer:once": "tsx src/indexer/run.ts --once",
    "indexer:recount": "tsx src/indexer/run.ts --recount",
    "forge:build": "forge build",
    "forge:test": "forge test -vv",
    "deploy:testnet": "forge script script/DeployVibeProofRegistry.s.sol:DeployVibeProofRegistry --rpc-url robinhood_testnet --broadcast --account ${DEPLOYER_ACCOUNT:-vibeproof-deployer}",
    "verify:testnet": "forge verify-contract --chain-id 46630 --verifier blockscout --verifier-url https://explorer.testnet.chain.robinhood.com/api/ ${REGISTRY_ADDRESS} contracts/VibeProofRegistry.sol:VibeProofRegistry"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "framer-motion": "^13.4.6",
    "geist": "^1.7.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.49.0",
    "next": "^16.3.7",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "viem": "^2.57.1",
    "wagmi": "^3.7.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.2"
  }
}
